<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
        <!-- Liquid Glass Theme Tokens -->
        <Color x:Key="CanvasBgColor">#000000</Color>
        <Color x:Key="AccentLiquidColor">#8A7FFF</Color>

        <!-- Liquid Glass Silver Gradient Brush (Bright, crisp, metallic shine against black) -->
        <LinearGradientBrush x:Key="LiquidGlassBrush" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#FFFFFF" Offset="0" />
            <GradientStop Color="#E8E8EE" Offset="0.3" />
            <GradientStop Color="#C0C0C8" Offset="0.75" />
            <GradientStop Color="#9898A0" Offset="1" />
        </LinearGradientBrush>

        <!-- Glowing Hover Brush -->
        <LinearGradientBrush x:Key="LiquidGlassHoverBrush" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#FFFFFF" Offset="0" />
            <GradientStop Color="#FFFFFF" Offset="0.7" />
            <GradientStop Color="#E0E0E8" Offset="1" />
        </LinearGradientBrush>

        <SolidColorBrush x:Key="AccentLiquidBrush" Color="{StaticResource AccentLiquidColor}" />

        <FontFamily x:Key="MonospaceFont">Consolas, Cascadia Code, Courier New, monospace</FontFamily>
    </Styles.Resources>

    <!-- Liquid Glass PathIcon -->
    <Style Selector="PathIcon.liquid-icon">
        <Setter Property="Foreground" Value="{StaticResource LiquidGlassBrush}" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Foreground" Duration="0:0:0.1" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.iris-btn:pointerover PathIcon.liquid-icon">
        <Setter Property="Foreground" Value="{StaticResource LiquidGlassHoverBrush}" />
    </Style>

    <!-- Flat Sleek Button (Modern Hitbox & Hover) -->
    <Style Selector="Button.iris-btn">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource LiquidGlassBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Width" Value="34" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.1" />
                <BrushTransition Property="Background" Duration="0:0:0.1" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.iris-btn:pointerover">
        <Setter Property="Background" Value="#25FFFFFF" />
    </Style>
    <Style Selector="Button.iris-btn:pressed">
        <Setter Property="Opacity" Value="0.6" />
    </Style>

    <!-- Pin Button with Tilted (45deg unpinned) vs Upright (0deg pinned) -->
    <Style Selector="Button.iris-pin-btn">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource LiquidGlassBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.iris-pin-btn PathIcon">
        <Setter Property="RenderTransform" Value="rotate(45deg)" />
        <Setter Property="Opacity" Value="0.65" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" />
                <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
                <BrushTransition Property="Foreground" Duration="0:0:0.2" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.iris-pin-btn:pointerover">
        <Setter Property="Background" Value="#25FFFFFF" />
    </Style>
    <Style Selector="Button.iris-pin-btn.pinned PathIcon">
        <Setter Property="RenderTransform" Value="rotate(0deg)" />
        <Setter Property="Opacity" Value="1.0" />
        <Setter Property="Foreground" Value="{StaticResource AccentLiquidBrush}" />
    </Style>

    <!-- Close Button (Red on Hover) -->
    <Style Selector="Button.iris-close-btn:pointerover">
        <Setter Property="Background" Value="#C42B1C" />
    </Style>
    <Style Selector="Button.iris-close-btn:pointerover PathIcon">
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <!-- Play / Pause Button (Clean Transparent Style matching all other buttons) -->
    <Style Selector="Button.iris-play-btn">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource LiquidGlassBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Width" Value="34" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.1" />
                <BrushTransition Property="Background" Duration="0:0:0.1" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.iris-play-btn:pointerover">
        <Setter Property="Background" Value="#25FFFFFF" />
    </Style>
    <Style Selector="Button.iris-play-btn:pressed">
        <Setter Property="Opacity" Value="0.6" />
    </Style>

    <!-- Sleek Text Button (e.g. 1.0X Speed, Clean Transparent Style) -->
    <Style Selector="Button.iris-text-btn">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource LiquidGlassBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.1" />
                <BrushTransition Property="Background" Duration="0:0:0.1" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.iris-text-btn:pointerover">
        <Setter Property="Background" Value="#25FFFFFF" />
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.iris-text-btn:pressed">
        <Setter Property="Opacity" Value="0.6" />
    </Style>

    <!-- Sleek Menu Item Button (Popover Items) -->
    <Style Selector="Button.iris-menu-item">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#DDDDDF" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.1" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.iris-menu-item:pointerover">
        <Setter Property="Background" Value="#26FFFFFF" />
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.iris-menu-item.active">
        <Setter Property="Background" Value="#24FFFFFF" />
        <Setter Property="Foreground" Value="{StaticResource AccentLiquidBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Liquid Glass Fat 12px Seekbar with Small 7px Ball Thumb - Centered Layout -->
    <Style Selector="Slider.iris-slider">
        <Style.Resources>
            <GridLength x:Key="SliderPreContentMargin">6</GridLength>
            <GridLength x:Key="SliderPostContentMargin">6</GridLength>
            <x:Double x:Key="SliderHorizontalHeight">24</x:Double>
            <x:Double x:Key="SliderTrackThemeHeight">12</x:Double>
            <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
            <CornerRadius x:Key="SliderTrackCornerRadius">6</CornerRadius>
            <CornerRadius x:Key="SliderThumbCornerRadius">3.5</CornerRadius>
            <x:Double x:Key="SliderHorizontalThumbWidth">7</x:Double>
            <x:Double x:Key="SliderHorizontalThumbHeight">7</x:Double>
            <SolidColorBrush x:Key="SliderThumbBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#FFFFFF" />
            <LinearGradientBrush x:Key="SliderTrackValueFill" StartPoint="0%,0%" EndPoint="100%,0%">
                <GradientStop Color="#FFFFFF" Offset="0" />
                <GradientStop Color="#E4E8F2" Offset="0.5" />
                <GradientStop Color="#B8C8E0" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="SliderTrackValueFillPointerOver" StartPoint="0%,0%" EndPoint="100%,0%">
                <GradientStop Color="#FFFFFF" Offset="0" />
                <GradientStop Color="#E4E8F2" Offset="0.5" />
                <GradientStop Color="#B8C8E0" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="SliderTrackValueFillPressed" StartPoint="0%,0%" EndPoint="100%,0%">
                <GradientStop Color="#FFFFFF" Offset="0" />
                <GradientStop Color="#E4E8F2" Offset="0.5" />
                <GradientStop Color="#B8C8E0" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="SliderTrackFill" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#44FFFFFF" />
            <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#55FFFFFF" />
        </Style.Resources>
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Background" Value="#33FFFFFF" />
        <Setter Property="Foreground">
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                <GradientStop Color="#FFFFFF" Offset="0" />
                <GradientStop Color="#E4E8F2" Offset="0.5" />
                <GradientStop Color="#B8C8E0" Offset="1" />
            </LinearGradientBrush>
        </Setter>
    </Style>

    <Style Selector="Slider.iris-slider /template/ RepeatButton#PART_IncreaseButton /template/ Border#TrackBackground">
        <Setter Property="BorderBrush" Value="#4DFFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="Slider.iris-slider:pointerover /template/ Thumb">
        <Setter Property="Width" Value="9" />
        <Setter Property="Height" Value="9" />
    </Style>

    <!-- Liquid Glass Fat 10px Volume Slider with Small 6px Ball Thumb - Centered Layout -->
    <Style Selector="Slider.iris-vol">
        <Style.Resources>
            <GridLength x:Key="SliderPreContentMargin">5</GridLength>
            <GridLength x:Key="SliderPostContentMargin">5</GridLength>
            <x:Double x:Key="SliderHorizontalHeight">20</x:Double>
            <x:Double x:Key="SliderTrackThemeHeight">10</x:Double>
            <CornerRadius x:Key="ControlCornerRadius">5</CornerRadius>
            <CornerRadius x:Key="SliderTrackCornerRadius">5</CornerRadius>
            <CornerRadius x:Key="SliderThumbCornerRadius">3</CornerRadius>
            <x:Double x:Key="SliderHorizontalThumbWidth">6</x:Double>
            <x:Double x:Key="SliderHorizontalThumbHeight">6</x:Double>
            <SolidColorBrush x:Key="SliderThumbBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#FFFFFF" />
            <LinearGradientBrush x:Key="SliderTrackValueFill" StartPoint="0%,0%" EndPoint="100%,0%">
                <GradientStop Color="#FFFFFF" Offset="0" />
                <GradientStop Color="#B8C8E0" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="SliderTrackValueFillPointerOver" StartPoint="0%,0%" EndPoint="100%,0%">
                <GradientStop Color="#FFFFFF" Offset="0" />
                <GradientStop Color="#B8C8E0" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="SliderTrackValueFillPressed" StartPoint="0%,0%" EndPoint="100%,0%">
                <GradientStop Color="#FFFFFF" Offset="0" />
                <GradientStop Color="#B8C8E0" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="SliderTrackFill" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#44FFFFFF" />
            <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#55FFFFFF" />
        </Style.Resources>
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="2,0,4,0" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Width" Value="68" />
        <Setter Property="Opacity" Value="0.9" />
        <Setter Property="Background" Value="#33FFFFFF" />
        <Setter Property="Foreground">
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                <GradientStop Color="#FFFFFF" Offset="0" />
                <GradientStop Color="#B8C8E0" Offset="1" />
            </LinearGradientBrush>
        </Setter>
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Slider.iris-vol:pointerover">
        <Setter Property="Opacity" Value="1.0" />
    </Style>

    <Style Selector="Slider.iris-vol /template/ RepeatButton#PART_IncreaseButton /template/ Border#TrackBackground">
        <Setter Property="BorderBrush" Value="#4DFFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="Slider.iris-vol:pointerover /template/ Thumb">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
    </Style>

    <!-- Volume Group Container -->
    <Style Selector="Border.volume-box">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.volume-box > StackPanel.volume-container">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Volume Slider Collapsible Wrapper (Hidden by default, expands smoothly on hover or scroll) -->
    <Style Selector="Border.vol-wrapper">
        <Setter Property="Width" Value="0" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Width" Duration="0:0:0.2" Easing="CubicEaseOut" />
                <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>

    <!-- Expand when mouse hovers over volume area -->
    <Style Selector="Border.volume-box:pointerover Border.vol-wrapper">
        <Setter Property="Width" Value="74" />
        <Setter Property="Opacity" Value="1.0" />
        <Setter Property="IsHitTestVisible" Value="True" />
    </Style>

    <!-- Expand when active/scrolling via class -->
    <Style Selector="Border.volume-box.expanded Border.vol-wrapper">
        <Setter Property="Width" Value="74" />
        <Setter Property="Opacity" Value="1.0" />
        <Setter Property="IsHitTestVisible" Value="True" />
    </Style>

    <!-- Segmented Tab Header Buttons (for CC Popover) -->
    <Style Selector="Button.iris-tab-btn">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#888890" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.1" />
                <BrushTransition Property="Foreground" Duration="0:0:0.1" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.iris-tab-btn:pointerover">
        <Setter Property="Background" Value="#1AFFFFFF" />
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.iris-tab-btn.active">
        <Setter Property="Background" Value="#2E2E38" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#44FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- Glassmorphic Top Menu Bar (VLC-Style) -->
    <Style Selector="Menu.iris-top-menu">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Height" Value="28" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Menu.iris-top-menu > MenuItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#D0D0D8" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.1" />
                <BrushTransition Property="Foreground" Duration="0:0:0.1" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Menu.iris-top-menu > MenuItem:pointerover">
        <Setter Property="Background" Value="#24FFFFFF" />
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Menu.iris-top-menu > MenuItem:open /template/ ContentPresenter#PART_HeaderPresenter">
        <Setter Property="Background" Value="#33FFFFFF" />
    </Style>

    <!-- Dropdown Menu Presentation -->
    <Style Selector="MenuFlyoutPresenter">
        <Setter Property="Background" Value="#F2141418" />
        <Setter Property="BorderBrush" Value="#33FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="4" />
    </Style>

    <Style Selector="MenuItem">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="#E0E0E6" />
    </Style>
    <Style Selector="MenuItem:pointerover">
        <Setter Property="Background" Value="#2AFFFFFF" />
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <Style Selector="Separator">
        <Setter Property="Background" Value="#20FFFFFF" />
        <Setter Property="Margin" Value="4,3" />
        <Setter Property="Height" Value="1" />
    </Style>

    <!-- Modern Dark Flyout Presenter -->
    <Style Selector="FlyoutPresenter">
        <Setter Property="Background" Value="#F2141418" />
        <Setter Property="BorderBrush" Value="#33FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="4" />
    </Style>

</Styles>
