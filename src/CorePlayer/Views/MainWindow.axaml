<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CorePlayer.ViewModels"
        xmlns:models="using:CorePlayer.Models"
        xmlns:mpv="clr-namespace:HanumanInstitute.LibMpv.Avalonia;assembly=HanumanInstitute.LibMpv.Avalonia"
        x:Class="CorePlayer.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="{Binding HeaderTitleText}"
        Width="1080" Height="620"
        MinWidth="540" MinHeight="320"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="#000000"
        Topmost="{Binding IsAlwaysOnTop}">

    <!-- Root Grid -->
    <Grid Background="#000000">

        <!-- ================= LAYER 0: VIDEO SURFACE & BACKGROUND CANVAS ================= -->
        <Grid>
            <!-- MPV OpenGL Hardware Video Surface -->
            <mpv:MpvView x:Name="PlayerView"
                         Renderer="OpenGl"
                         HorizontalAlignment="Stretch"
                         VerticalAlignment="Stretch" />

            <!-- Pure Blank Black Canvas when no media is loaded (No center icon or text) -->
            <Border IsVisible="{Binding !HasMedia}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="#000000" />

            <!-- Active Drag-Over Highlight Border -->
            <Border BorderBrush="{StaticResource AccentLiquidBrush}"
                    BorderThickness="1"
                    IsVisible="{Binding IsDraggingOver}"
                    IsHitTestVisible="False"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch" />

            <!-- Interaction Surface (Gestures, Single/Double Tap, Drag-Drop) -->
            <Border Background="Transparent"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    PointerMoved="OnVideoAreaPointerMoved"
                    PointerPressed="OnVideoAreaPointerPressed"
                    DoubleTapped="OnVideoAreaDoubleTapped"
                    DragDrop.AllowDrop="True" />
        </Grid>

        <!-- ================= LAYER 1: QUIET HUD, PROMPT & TOAST OVERLAYS ================= -->

        <!-- YouTube-Style Left Skip HUD (Rewind) -->
        <Border IsVisible="{Binding IsSkipBackwardHudVisible}"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Margin="60,0,0,0"
                Background="#B30D0D11"
                BorderBrush="#25FFFFFF"
                BorderThickness="1"
                CornerRadius="24"
                Padding="22,14"
                BoxShadow="0 4 20 #60000000"
                IsHitTestVisible="False">
            <StackPanel Orientation="Vertical" Spacing="4" HorizontalAlignment="Center">
                <PathIcon Data="{StaticResource SkipBackwardChevronIcon}"
                          Width="26" Height="26"
                          Foreground="#FFFFFF"
                          HorizontalAlignment="Center" />
                <TextBlock Text="{Binding SkipBackwardText}"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="#FFFFFF"
                           FontFamily="{StaticResource MonospaceFont}"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- YouTube-Style Right Skip HUD (Fast-Forward) -->
        <Border IsVisible="{Binding IsSkipForwardHudVisible}"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Margin="0,0,60,0"
                Background="#B30D0D11"
                BorderBrush="#25FFFFFF"
                BorderThickness="1"
                CornerRadius="24"
                Padding="22,14"
                BoxShadow="0 4 20 #60000000"
                IsHitTestVisible="False">
            <StackPanel Orientation="Vertical" Spacing="4" HorizontalAlignment="Center">
                <PathIcon Data="{StaticResource SkipForwardChevronIcon}"
                          Width="26" Height="26"
                          Foreground="#FFFFFF"
                          HorizontalAlignment="Center" />
                <TextBlock Text="{Binding SkipForwardText}"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="#FFFFFF"
                           FontFamily="{StaticResource MonospaceFont}"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Toast Notification -->
        <Border IsVisible="{Binding IsToastVisible}"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,50"
                Background="#E6161618"
                BorderBrush="#282828"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12,5">
            <TextBlock Text="{Binding ToastMessage}"
                       FontSize="11"
                       Foreground="#EEEEEE" />
        </Border>

        <!-- ================= LAYER 2: SLIM CLEAN TOP BAR WITH TITLE & CONTROLS ================= -->
        <Border x:Name="TopBarBorder"
                VerticalAlignment="Top"
                Height="36"
                Background="Transparent"
                Padding="14,0,0,0"
                Margin="0,0,6,0"
                PointerPressed="OnTopBarPointerPressed"
                IsVisible="{Binding IsControlsVisible}">
            <Grid ColumnDefinitions="*, Auto" VerticalAlignment="Center">
                <!-- 1. Currently playing file indicator (character ellipsis before window buttons) -->
                <Grid Grid.Column="0"
                      ColumnDefinitions="Auto, *"
                      VerticalAlignment="Center"
                      Margin="0,0,16,0">
                    <TextBlock Grid.Column="1"
                               Text="{Binding HeaderTitleText}"
                               FontSize="12"
                               FontWeight="Medium"
                               Foreground="#CCCCCC"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding HeaderTitleText}" />
                </Grid>

                <!-- 2. Top-Right Window Controls (Pin, Minimize, Maximize/Restore, Close) - Fixed permanently across all modes -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="0,0,4,0">
                    <!-- Pin (Always On Top) Icon Button with Tilt / Straight state -->
                    <Button Classes="iris-pin-btn"
                            Classes.pinned="{Binding IsAlwaysOnTop}"
                            Command="{Binding ToggleAlwaysOnTopCommand}"
                            ToolTip.Tip="Always on Top (Pin)"
                            VerticalAlignment="Center">
                        <PathIcon Data="{StaticResource PinIcon}"
                                  Width="15" Height="15"
                                  Classes="liquid-icon" />
                    </Button>

                    <!-- Minimize -->
                    <Button Classes="iris-btn" Click="OnMinimizeClick" ToolTip.Tip="Minimize" Width="28" Height="28">
                        <PathIcon Data="{StaticResource MinimizeIcon}" Width="12" Height="12" Classes="liquid-icon" />
                    </Button>

                    <!-- Maximize / Restore (The Box Button) - Fixed across windowed and fullscreen -->
                    <Button Classes="iris-btn" Click="OnMaximizeClick" ToolTip.Tip="Maximize / Restore" Width="28" Height="28">
                        <PathIcon Data="{StaticResource MaximizeIcon}" Width="12" Height="12" Classes="liquid-icon" />
                    </Button>

                    <!-- Close / Quit -->
                    <Button Classes="iris-btn iris-close-btn" Click="OnCloseClick" ToolTip.Tip="Close (Alt+F4)" Width="28" Height="28">
                        <PathIcon Data="{StaticResource CloseIcon}" Width="10" Height="10" Classes="liquid-icon" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= LAYER 3: LIQUID GLASS DOCKED BOTTOM CONTROL STRIP ================= -->
        <!-- Single horizontal row docked flush to the bottom; 46px height with prominent liquid glass controls -->
        <Border VerticalAlignment="Bottom"
                Height="46"
                IsVisible="{Binding IsControlsVisible}">
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Color="#00000000" Offset="0" />
                    <GradientStop Color="#80000000" Offset="0.3" />
                    <GradientStop Color="#E6000000" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>

            <!-- Single continuous horizontal line -->
            <Grid ColumnDefinitions="Auto, *, Auto" Margin="12,0,12,0" VerticalAlignment="Center">

                <!-- ===== LEFT GROUP: PLAYBACK & SOUND CONTROLS ===== -->
                <!-- [Play] [Prev] [Next] [Shuffle] [Repeat] [1.0X] [VolIcon] [VolSlider] -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <!-- Play / Pause Featured Liquid Capsule -->
                    <Button Classes="iris-play-btn" Command="{Binding TogglePlayPauseCommand}" ToolTip.Tip="Play / Pause (Space)">
                        <Panel>
                            <PathIcon Data="{StaticResource PlayIcon}" Width="18" Height="18" Classes="liquid-icon" IsVisible="{Binding !IsPlaying}" Margin="2,0,0,0" />
                            <PathIcon Data="{StaticResource PauseIcon}" Width="18" Height="18" Classes="liquid-icon" IsVisible="{Binding IsPlaying}" />
                        </Panel>
                    </Button>

                    <!-- Previous Track -->
                    <Button Classes="iris-btn" Command="{Binding PlayPreviousTrackCommand}" ToolTip.Tip="Previous File (Shift+P)">
                        <PathIcon Data="{StaticResource PrevIcon}" Width="18" Height="18" Classes="liquid-icon" />
                    </Button>

                    <!-- Next Track -->
                    <Button Classes="iris-btn" Command="{Binding PlayNextTrackCommand}" ToolTip.Tip="Next File (Shift+N)">
                        <PathIcon Data="{StaticResource NextIcon}" Width="18" Height="18" Classes="liquid-icon" />
                    </Button>

                    <!-- Shuffle -->
                    <Button Classes="iris-btn" Command="{Binding ToggleShuffleCommand}" ToolTip.Tip="Shuffle">
                        <PathIcon Data="{StaticResource ShuffleIcon}" Width="18" Height="18" Classes="liquid-icon" Opacity="{Binding ShuffleOpacity}" />
                    </Button>

                    <!-- Repeat -->
                    <Button Classes="iris-btn" Command="{Binding ToggleRepeatCommand}" ToolTip.Tip="Repeat (Off / All / One)">
                        <PathIcon Data="{StaticResource RepeatIcon}" Width="18" Height="18" Classes="liquid-icon" Opacity="{Binding RepeatOpacity}" />
                    </Button>

                    <!-- Speed Indicator (1.0X) -->
                    <Button Classes="iris-text-btn" Command="{Binding CycleSpeedCommand}" ToolTip.Tip="Playback Speed">
                        <TextBlock Text="{Binding SpeedDisplayUpper}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource LiquidGlassBrush}"
                                   VerticalAlignment="Center" />
                    </Button>

                    <!-- Volume Group (Collapsed by default; expands on hover; scroll wheel adjusts volume) -->
                    <Border x:Name="VolumeControlBorder"
                            Classes="volume-box"
                            Background="Transparent"
                            VerticalAlignment="Center"
                            PointerEntered="OnVolumePointerEntered"
                            PointerExited="OnVolumePointerExited"
                            PointerWheelChanged="OnVolumePointerWheelChanged">
                        <StackPanel Classes="volume-container" Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent">
                            <!-- Volume / Mute Button -->
                            <Button Classes="iris-btn" Command="{Binding ToggleMuteCommand}" ToolTip.Tip="Mute (M)">
                                <Panel>
                                    <PathIcon Data="{StaticResource VolumeHighIcon}" Width="19" Height="19" Classes="liquid-icon" IsVisible="{Binding !IsMuted}" />
                                    <PathIcon Data="{StaticResource VolumeMuteIcon}" Width="19" Height="19" Classes="liquid-icon" IsVisible="{Binding IsMuted}" Foreground="#FF5555" />
                                </Panel>
                            </Button>

                            <!-- Liquid Glass Volume Slider (Collapsed by default, expands on hover or wheel) -->
                            <Border x:Name="VolumeSliderWrapper"
                                    Classes="vol-wrapper"
                                    ClipToBounds="True"
                                    VerticalAlignment="Center">
                                <Slider x:Name="VolumeSlider"
                                        Classes="iris-vol"
                                        Minimum="0" Maximum="150"
                                        Value="{Binding Volume, Mode=TwoWay}"
                                        VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== CENTER GROUP: INLINE LIQUID GLASS TIMELINE ===== -->
                <!-- [00:00] [===================o===================] [00:00] -->
                <Grid Grid.Column="1" ColumnDefinitions="Auto, *, Auto" VerticalAlignment="Center" Margin="8,0,8,0">
                    <!-- Current Position -->
                    <TextBlock Grid.Column="0"
                               Text="{Binding PositionFormatted}"
                               FontSize="12"
                               FontWeight="Medium"
                               Foreground="#EEEEEE"
                               FontFamily="{StaticResource MonospaceFont}"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0" />

                    <!-- Liquid Glass Broad 12px Seekbar with Small Ball Thumb (Perfect True Center) -->
                    <Slider x:Name="TimelineSlider"
                            Grid.Column="1"
                            Classes="iris-slider"
                            Minimum="0"
                            Maximum="{Binding DurationSeconds}"
                            Value="{Binding PositionSeconds, Mode=TwoWay}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Stretch"
                            MinWidth="30"
                            Margin="0" />

                    <!-- Total Duration -->
                    <TextBlock Grid.Column="2"
                               Text="{Binding DurationFormatted}"
                               FontSize="12"
                               FontWeight="Medium"
                               Foreground="#EEEEEE"
                               FontFamily="{StaticResource MonospaceFont}"
                               VerticalAlignment="Center"
                               Margin="6,0,0,0" />
                </Grid>

                <!-- ===== RIGHT GROUP: TOOLS & OPTIONS ===== -->
                <!-- [Subtitles] [Menu (3 Lines)] [Fullscreen] -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <!-- Subtitles / CC -->
                    <Button Classes="iris-btn" Command="{Binding ToggleTracksMenuCommand}" ToolTip.Tip="Subtitles &amp; Audio (C)">
                        <PathIcon Data="{StaticResource CcIcon}" Width="19" Height="19" Classes="liquid-icon" />
                    </Button>

                    <!-- Options Menu (Three Lines / Hamburger) -->
                    <Button Classes="iris-btn" Command="{Binding ToggleMoreMenuCommand}" ToolTip.Tip="Options (Three Lines)">
                        <PathIcon Data="{StaticResource MenuLinesIcon}" Width="18" Height="18" Classes="liquid-icon" />
                    </Button>

                    <!-- Fullscreen Toggle -->
                    <Button Classes="iris-btn" Command="{Binding ToggleFullscreenCommand}" ToolTip.Tip="Fullscreen (F)">
                        <Panel>
                            <PathIcon Data="{StaticResource FullscreenIcon}" Width="18" Height="18" Classes="liquid-icon" IsVisible="{Binding !IsFullscreen}" />
                            <PathIcon Data="{StaticResource ExitFullscreenIcon}" Width="18" Height="18" Classes="liquid-icon" IsVisible="{Binding IsFullscreen}" />
                        </Panel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= LAYER 3.5: TIMELINE HOVER PREVIEW CARD (NETFLIX / YOUTUBE STYLE) ================= -->
        <Border x:Name="HoverPreviewCard"
                IsVisible="{Binding IsHoverPreviewVisible}"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="0,0,0,52"
                Width="188"
                Background="#EE121316"
                BorderBrush="#40FFFFFF"
                BorderThickness="1"
                CornerRadius="8"
                BoxShadow="0 8 28 #95000000"
                IsHitTestVisible="False">
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.1" />
                </Transitions>
            </Border.Transitions>
            <Grid RowDefinitions="Auto, Auto" Margin="5,5,5,4">
                <!-- Thumbnail Image Container with subtle rounded corner clip -->
                <Border Grid.Row="0"
                        CornerRadius="5"
                        ClipToBounds="True"
                        Background="#08090C"
                        Height="102"
                        Width="176"
                        HorizontalAlignment="Center">
                    <Panel>
                        <!-- Fallback / Placeholder film camera icon while thumbnail renders -->
                        <PathIcon Data="{StaticResource CameraIcon}"
                                  Width="20" Height="20"
                                  Foreground="#30FFFFFF"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  IsVisible="{Binding HoverPreviewBitmap, Converter={x:Static ObjectConverters.IsNull}}" />

                        <!-- Video Frame Image -->
                        <Image Source="{Binding HoverPreviewBitmap}"
                               Stretch="UniformToFill"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsVisible="{Binding HoverPreviewBitmap, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </Panel>
                </Border>

                <!-- Formatted Timestamp Badge -->
                <TextBlock Grid.Row="1"
                           Text="{Binding HoverPreviewTime}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#EEEEEE"
                           FontFamily="{StaticResource MonospaceFont}"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,1" />
            </Grid>
        </Border>

        <!-- ================= LAYER 4: MODERN OPTIONS SIDE PANEL DRAWER (SWIPES FROM RIGHT) ================= -->
        <Border IsVisible="{Binding IsMoreMenuOpen}"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Width="320"
                Background="#F6121316"
                BorderBrush="#26272E"
                BorderThickness="1,0,0,0"
                BoxShadow="-12 0 40 #95000000">
            <Grid RowDefinitions="Auto, *" Margin="14,38,14,14">
                <!-- Header (Title / Back / Close) -->
                <Grid Grid.Row="0" Margin="4,0,4,14" VerticalAlignment="Center">
                    <!-- Left: Back Button (shown on sub-pages: Settings, Aspect Ratio, Speed) -->
                    <Button HorizontalAlignment="Left"
                            Classes="iris-drawer-back-btn"
                            Command="{Binding NavigateBackCommand}"
                            IsVisible="{Binding IsOptionsSubPage}"
                            ToolTip.Tip="Back to Options">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource ChevronLeftIcon}" Width="12" Height="12" Foreground="#CBD5E1" />
                            <TextBlock Text="Back" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Center: Drawer Title -->
                    <TextBlock Text="{Binding OptionsPanelTitle}"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="#FFFFFF"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />

                    <!-- Right: Close Drawer Button -->
                    <Button HorizontalAlignment="Right"
                            Classes="iris-drawer-close-btn"
                            Command="{Binding CloseMoreMenuCommand}"
                            ToolTip.Tip="Close Options (Esc)">
                        <PathIcon Data="{StaticResource CloseIcon}" Width="11" Height="11" Foreground="#94A3B8" />
                    </Button>
                </Grid>

                <!-- Content Area -->
                <ScrollViewer Grid.Row="1">
                    <Panel>
                        <!-- ================= PAGE 0: MAIN OPTIONS LIST ================= -->
                        <StackPanel IsVisible="{Binding IsOptionsRootPage}" Spacing="2">
                            <!-- Open File -->
                            <Button Classes="iris-drawer-item" Click="OnOpenFileClick">
                                <Grid ColumnDefinitions="Auto, *, Auto">
                                    <PathIcon Grid.Column="0" Data="{StaticResource FolderIcon}" Width="16" Height="16" Foreground="#CBD5E1" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Open File..." FontSize="13" FontWeight="Medium" Foreground="#EEEEEE" />
                                        <TextBlock Text="Choose media to play" FontSize="11" Foreground="#94A3B8" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="Ctrl+O" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Border Height="1" Background="#0EFFFFFF" Margin="8,0" />

                            <!-- Open Folder -->
                            <Button Classes="iris-drawer-item" Click="OnOpenFolderClick">
                                <Grid ColumnDefinitions="Auto, *, Auto">
                                    <PathIcon Grid.Column="0" Data="{StaticResource FolderIcon}" Width="16" Height="16" Foreground="#CBD5E1" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Open Folder..." FontSize="13" FontWeight="Medium" Foreground="#EEEEEE" />
                                        <TextBlock Text="Play all media in folder" FontSize="11" Foreground="#94A3B8" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="Ctrl+F" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Border Height="1" Background="#0EFFFFFF" Margin="8,0" />

                            <!-- Open URL / Stream -->
                            <Button Classes="iris-drawer-item" Click="OnOpenUrlClick">
                                <Grid ColumnDefinitions="Auto, *, Auto">
                                    <PathIcon Grid.Column="0" Data="{StaticResource IrisBadgeIcon}" Width="16" Height="16" Foreground="#CBD5E1" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Open URL / Stream..." FontSize="13" FontWeight="Medium" Foreground="#EEEEEE" />
                                        <TextBlock Text="Direct network stream" FontSize="11" Foreground="#94A3B8" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="Ctrl+U" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Border Height="1" Background="#0EFFFFFF" Margin="8,0" />

                            <!-- Take Snapshot -->
                            <Button Classes="iris-drawer-item" Command="{Binding TakeSnapshotCommand}">
                                <Grid ColumnDefinitions="Auto, *, Auto">
                                    <PathIcon Grid.Column="0" Data="{StaticResource CameraIcon}" Width="16" Height="16" Foreground="#CBD5E1" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Take Snapshot" FontSize="13" FontWeight="Medium" Foreground="#EEEEEE" />
                                        <TextBlock Text="Save frame to Pictures" FontSize="11" Foreground="#94A3B8" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="Ctrl+S" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Border Height="1" Background="#0EFFFFFF" Margin="8,0" />

                            <!-- Aspect Ratio (Navigates to sub-page) -->
                            <Button Classes="iris-drawer-item" Command="{Binding NavigateToOptionsPageCommand}" CommandParameter="2">
                                <Grid ColumnDefinitions="Auto, *, Auto">
                                    <PathIcon Grid.Column="0" Data="{StaticResource AspectRatioIcon}" Width="16" Height="16" Foreground="#CBD5E1" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Aspect Ratio" FontSize="13" FontWeight="Medium" Foreground="#EEEEEE" />
                                        <TextBlock Text="Fit, 16:9, 4:3, 2.35:1" FontSize="11" Foreground="#94A3B8" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding AspectRatioName}" FontSize="12" Foreground="#CBD5E1" FontWeight="Medium" VerticalAlignment="Center" />
                                        <PathIcon Data="{StaticResource ChevronRightIcon}" Width="10" Height="10" Foreground="#64748B" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <Border Height="1" Background="#0EFFFFFF" Margin="8,0" />

                            <!-- Playback Speed (Navigates to sub-page) -->
                            <Button Classes="iris-drawer-item" Command="{Binding NavigateToOptionsPageCommand}" CommandParameter="3">
                                <Grid ColumnDefinitions="Auto, *, Auto">
                                    <PathIcon Grid.Column="0" Data="{StaticResource StepForwardIcon}" Width="16" Height="16" Foreground="#CBD5E1" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Playback Speed" FontSize="13" FontWeight="Medium" Foreground="#EEEEEE" />
                                        <TextBlock Text="Slow motion or fast playback" FontSize="11" Foreground="#94A3B8" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SpeedDisplayUpper}" FontSize="12" Foreground="#CBD5E1" FontWeight="Medium" VerticalAlignment="Center" />
                                        <PathIcon Data="{StaticResource ChevronRightIcon}" Width="10" Height="10" Foreground="#64748B" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <Border Height="1" Background="#0EFFFFFF" Margin="8,0" />

                            <!-- Rotate Video -->
                            <Button Classes="iris-drawer-item" Command="{Binding CycleRotationCommand}">
                                <Grid ColumnDefinitions="Auto, *, Auto">
                                    <PathIcon Grid.Column="0" Data="{StaticResource RotateIcon}" Width="16" Height="16" Foreground="#CBD5E1" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Rotate Video" FontSize="13" FontWeight="Medium" Foreground="#EEEEEE" />
                                        <TextBlock Text="Click to cycle orientation" FontSize="11" Foreground="#94A3B8" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding RotationName}" FontSize="12" Foreground="#CBD5E1" FontWeight="Medium" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Border Height="1" Background="#0EFFFFFF" Margin="8,0" />

                            <!-- Subtitles & Audio Tracks -->
                            <Button Classes="iris-drawer-item" Command="{Binding OpenTracksFromOptionsCommand}">
                                <Grid ColumnDefinitions="Auto, *, Auto">
                                    <PathIcon Grid.Column="0" Data="{StaticResource CcIcon}" Width="16" Height="16" Foreground="#CBD5E1" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Tracks &amp; Delay" FontSize="13" FontWeight="Medium" Foreground="#EEEEEE" />
                                        <TextBlock Text="Audio dubs and subtitles" FontSize="11" Foreground="#94A3B8" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="C" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" />
                                        <PathIcon Data="{StaticResource ChevronRightIcon}" Width="10" Height="10" Foreground="#64748B" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <Border Height="1" Background="#0EFFFFFF" Margin="8,0" />

                            <!-- Playlist Queue -->
                            <Button Classes="iris-drawer-item" Command="{Binding OpenQueueFromOptionsCommand}">
                                <Grid ColumnDefinitions="Auto, *, Auto">
                                    <PathIcon Grid.Column="0" Data="{StaticResource PlaylistIrisIcon}" Width="16" Height="16" Foreground="#CBD5E1" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Playlist Queue" FontSize="13" FontWeight="Medium" Foreground="#EEEEEE" />
                                        <TextBlock Text="View or manage queue" FontSize="11" Foreground="#94A3B8" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Playlist.Count, StringFormat='{}{0} files'}" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
                                        <PathIcon Data="{StaticResource ChevronRightIcon}" Width="10" Height="10" Foreground="#64748B" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <Border Height="1" Background="#0EFFFFFF" Margin="8,0" />

                            <!-- Technical Specs Box -->
                            <Border Background="#0CFFFFFF" CornerRadius="8" Padding="12,10" Margin="0,6,0,6">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="MEDIA SPECIFICATIONS" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                                    <TextBlock Text="{Binding Resolution, StringFormat='Resolution: {0}'}" FontSize="11" Foreground="#CBD5E1" />
                                    <TextBlock Text="{Binding VideoCodec, StringFormat='Video Codec: {0}'}" FontSize="11" Foreground="#CBD5E1" />
                                    <TextBlock Text="{Binding AudioCodec, StringFormat='Audio Codec: {0}'}" FontSize="11" Foreground="#CBD5E1" />
                                </StackPanel>
                            </Border>
                            <Border Height="1" Background="#0EFFFFFF" Margin="8,0" />

                            <!-- SETTINGS (At last, prominent with subtitle & chevron) -->
                            <Button Classes="iris-drawer-item"
                                    Command="{Binding NavigateToOptionsPageCommand}"
                                    CommandParameter="1"
                                    Background="#14FFFFFF"
                                    Margin="0,4,0,0">
                                <Grid ColumnDefinitions="Auto, *, Auto">
                                    <PathIcon Grid.Column="0" Data="{StaticResource SettingsGearIcon}" Width="18" Height="18" Foreground="#CBD5E1" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Settings" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                        <TextBlock Text="Preferences, Audio &amp; Video Options" FontSize="11" Foreground="#94A3B8" />
                                    </StackPanel>
                                    <PathIcon Grid.Column="2" Data="{StaticResource ChevronRightIcon}" Width="12" Height="12" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                        </StackPanel>

                        <!-- ================= PAGE 1: SETTINGS SUB-PAGE ================= -->
                        <StackPanel IsVisible="{Binding IsSettingsSubPage}" Spacing="2">
                            <!-- Snapshot Storage Location -->
                            <Border Background="#10FFFFFF" CornerRadius="8" Padding="12,10" Margin="0,2,0,4">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="Auto, *">
                                        <PathIcon Grid.Column="0" Data="{StaticResource CameraIcon}" Width="15" Height="15" Foreground="#CBD5E1" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="Snapshot Storage Folder" FontSize="13" FontWeight="SemiBold" Foreground="#EEEEEE" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Text="{Binding SnapshotDirectoryDisplay}" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" />
                                    <Grid ColumnDefinitions="*, *" Margin="0,4,0,0">
                                        <Button Grid.Column="0" Classes="iris-drawer-back-btn" Click="OnChangeSnapshotFolderClick" Margin="0,0,4,0" HorizontalAlignment="Stretch">
                                            <TextBlock Text="Change..." FontSize="11" HorizontalAlignment="Center" />
                                        </Button>
                                        <Button Grid.Column="1" Classes="iris-drawer-back-btn" Click="OnOpenSnapshotFolderClick" Margin="4,0,0,0" HorizontalAlignment="Stretch">
                                            <TextBlock Text="Open Folder" FontSize="11" HorizontalAlignment="Center" />
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Height="1" Background="#0EFFFFFF" Margin="8,0" />

                            <!-- Auto-Resume Playback -->
                            <Button Classes="iris-drawer-item" Command="{Binding ToggleAutoResumeCommand}">
                                <Grid ColumnDefinitions="Auto, *, Auto">
                                    <PathIcon Grid.Column="0" Data="{StaticResource PlayIcon}" Width="16" Height="16" Foreground="#CBD5E1" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Auto-Resume Media" FontSize="13" FontWeight="Medium" Foreground="#EEEEEE" />
                                        <TextBlock Text="Resume from where you left off" FontSize="11" Foreground="#94A3B8" />
                                    </StackPanel>
                                    <Border Grid.Column="2" CornerRadius="4" Padding="8,3" Background="#1838BDF8" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding AutoResumeStatusText}" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8" />
                                    </Border>
                                </Grid>
                            </Button>
                            <Border Height="1" Background="#0EFFFFFF" Margin="8,0" />

                            <!-- Skipping & Frame Interval (Navigates to Page 4) -->
                            <Button Classes="iris-drawer-item" Command="{Binding OpenSkippingSettingsCommand}">
                                <Grid ColumnDefinitions="Auto, *, Auto">
                                    <PathIcon Grid.Column="0" Data="{StaticResource SkipForwardChevronIcon}" Width="16" Height="16" Foreground="#CBD5E1" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Skipping &amp; Frame Interval" FontSize="13" FontWeight="Medium" Foreground="#EEEEEE" />
                                        <TextBlock Text="Custom skip dial, manual input &amp; presets" FontSize="11" Foreground="#94A3B8" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Border CornerRadius="4" Padding="8,3" Background="#1838BDF8">
                                            <TextBlock Text="{Binding SeekStepDisplay}" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8" />
                                        </Border>
                                        <PathIcon Data="{StaticResource ChevronRightIcon}" Width="10" Height="10" Foreground="#64748B" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <Border Height="1" Background="#0EFFFFFF" Margin="8,0" />

                            <!-- Timeline Hover Preview -->
                            <Button Classes="iris-drawer-item" Command="{Binding ToggleHoverPreviewCommand}">
                                <Grid ColumnDefinitions="Auto, *, Auto">
                                    <PathIcon Grid.Column="0" Data="{StaticResource CameraIcon}" Width="16" Height="16" Foreground="#CBD5E1" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Timeline Hover Preview" FontSize="13" FontWeight="Medium" Foreground="#EEEEEE" />
                                        <TextBlock Text="Show Netflix-style frame preview on hover" FontSize="11" Foreground="#94A3B8" />
                                    </StackPanel>
                                    <Border Grid.Column="2" CornerRadius="4" Padding="8,3" Background="#1838BDF8" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding HoverPreviewStatusText}" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8" />
                                    </Border>
                                </Grid>
                            </Button>
                            <Border Height="1" Background="#0EFFFFFF" Margin="8,0" />

                            <!-- Night Mode Normalizer -->
                            <Button Classes="iris-drawer-item" Command="{Binding ToggleNightModeCommand}">
                                <Grid ColumnDefinitions="Auto, *, Auto">
                                    <PathIcon Grid.Column="0" Data="{StaticResource MoonIcon}" Width="16" Height="16" Foreground="#CBD5E1" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Night Mode (Normalizer)" FontSize="13" FontWeight="Medium" Foreground="#EEEEEE" />
                                        <TextBlock Text="Compress loud audio peaks" FontSize="11" Foreground="#94A3B8" />
                                    </StackPanel>
                                    <Border Grid.Column="2" CornerRadius="4" Padding="8,3" Background="#1838BDF8" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding NightModeStatusText}" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8" />
                                    </Border>
                                </Grid>
                            </Button>
                            <Border Height="1" Background="#0EFFFFFF" Margin="8,0" />

                            <!-- Always On Top -->
                            <Button Classes="iris-drawer-item" Command="{Binding ToggleAlwaysOnTopCommand}">
                                <Grid ColumnDefinitions="Auto, *, Auto">
                                    <PathIcon Grid.Column="0" Data="{StaticResource PinIcon}" Width="16" Height="16" Foreground="#CBD5E1" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Always on Top (Pin)" FontSize="13" FontWeight="Medium" Foreground="#EEEEEE" />
                                        <TextBlock Text="Keep window above other apps" FontSize="11" Foreground="#94A3B8" />
                                    </StackPanel>
                                    <Border Grid.Column="2" CornerRadius="4" Padding="8,3" Background="#1838BDF8" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding AlwaysOnTopStatusText}" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8" />
                                    </Border>
                                </Grid>
                            </Button>
                            <Border Height="1" Background="#0EFFFFFF" Margin="8,0" />

                            <!-- Hardware Video Acceleration -->
                            <Border Classes="iris-drawer-item" Padding="14,10">
                                <Grid ColumnDefinitions="Auto, *, Auto">
                                    <PathIcon Grid.Column="0" Data="{StaticResource IrisBadgeIcon}" Width="16" Height="16" Foreground="#4EC9B0" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Hardware Decoding" FontSize="13" FontWeight="Medium" Foreground="#EEEEEE" />
                                        <TextBlock Text="GPU Native Pipeline (OpenGL / WGL)" FontSize="11" Foreground="#94A3B8" />
                                    </StackPanel>
                                    <Border Grid.Column="2" CornerRadius="4" Padding="8,3" Background="#184EC9B0" VerticalAlignment="Center">
                                        <TextBlock Text="Active" FontSize="11" FontWeight="SemiBold" Foreground="#4EC9B0" />
                                    </Border>
                                </Grid>
                            </Border>
                            <Border Height="1" Background="#0EFFFFFF" Margin="8,0" />

                            <!-- Repeat Playback Mode -->
                            <Button Classes="iris-drawer-item" Command="{Binding ToggleRepeatCommand}">
                                <Grid ColumnDefinitions="Auto, *, Auto">
                                    <PathIcon Grid.Column="0" Data="{StaticResource RepeatIcon}" Width="16" Height="16" Foreground="#CBD5E1" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Repeat Mode" FontSize="13" FontWeight="Medium" Foreground="#EEEEEE" />
                                        <TextBlock Text="Click to toggle Off, All, One" FontSize="11" Foreground="#94A3B8" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding RepeatModeName}" FontSize="12" Foreground="#CBD5E1" FontWeight="Medium" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Border Height="1" Background="#0EFFFFFF" Margin="8,0" />

                            <!-- Shuffle Mode -->
                            <Button Classes="iris-drawer-item" Command="{Binding ToggleShuffleCommand}">
                                <Grid ColumnDefinitions="Auto, *, Auto">
                                    <PathIcon Grid.Column="0" Data="{StaticResource ShuffleIcon}" Width="16" Height="16" Foreground="#CBD5E1" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Shuffle Playlist" FontSize="13" FontWeight="Medium" Foreground="#EEEEEE" />
                                        <TextBlock Text="Randomize track order" FontSize="11" Foreground="#94A3B8" />
                                    </StackPanel>
                                    <Border Grid.Column="2" CornerRadius="4" Padding="8,3" Background="#1838BDF8" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ShuffleStatusText}" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8" />
                                    </Border>
                                </Grid>
                            </Button>
                            <Border Height="1" Background="#0EFFFFFF" Margin="8,0" />

                            <!-- Preferences -->
                            <Button Classes="iris-drawer-item" Command="{Binding OpenPreferencesCommand}">
                                <Grid ColumnDefinitions="Auto, *, Auto">
                                    <PathIcon Grid.Column="0" Data="{StaticResource SettingsGearIcon}" Width="16" Height="16" Foreground="#CBD5E1" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Advanced Preferences..." FontSize="13" FontWeight="Medium" Foreground="#EEEEEE" />
                                        <TextBlock Text="Audio/video renderer configuration" FontSize="11" Foreground="#94A3B8" />
                                    </StackPanel>
                                    <PathIcon Grid.Column="2" Data="{StaticResource ChevronRightIcon}" Width="10" Height="10" Foreground="#64748B" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Border Height="1" Background="#0EFFFFFF" Margin="8,0" />

                            <!-- About CORE PLAYER -->
                            <Button Classes="iris-drawer-item" Click="OnAboutClick">
                                <Grid ColumnDefinitions="Auto, *, Auto">
                                    <PathIcon Grid.Column="0" Data="{StaticResource IrisBadgeIcon}" Width="16" Height="16" Foreground="#CBD5E1" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="About CORE PLAYER" FontSize="13" FontWeight="Medium" Foreground="#EEEEEE" />
                                        <TextBlock Text="v1.0 • Liquid Glass Edition" FontSize="11" Foreground="#94A3B8" />
                                    </StackPanel>
                                    <PathIcon Grid.Column="2" Data="{StaticResource ChevronRightIcon}" Width="10" Height="10" Foreground="#64748B" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                        </StackPanel>

                        <!-- ================= PAGE 2: ASPECT RATIO SUB-PAGE ================= -->
                        <StackPanel IsVisible="{Binding IsAspectRatioSubPage}" Spacing="2">
                            <!-- Fit to Window -->
                            <Button Classes="iris-drawer-item" Command="{Binding SetAspectRatioCommand}" CommandParameter="-1">
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Grid.Column="0" Text="Fit to Window (Default)" FontSize="13" FontWeight="Medium" Foreground="#EEEEEE" VerticalAlignment="Center" />
                                    <PathIcon Grid.Column="1" Data="{StaticResource CheckIcon}" Width="12" Height="12" Foreground="#38BDF8" IsVisible="{Binding IsAspectFit}" />
                                </Grid>
                            </Button>
                            <Border Height="1" Background="#0EFFFFFF" Margin="8,0" />

                            <!-- 16:9 Widescreen -->
                            <Button Classes="iris-drawer-item" Command="{Binding SetAspectRatioCommand}" CommandParameter="16:9">
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Grid.Column="0" Text="16:9 Widescreen" FontSize="13" FontWeight="Medium" Foreground="#EEEEEE" VerticalAlignment="Center" />
                                    <PathIcon Grid.Column="1" Data="{StaticResource CheckIcon}" Width="12" Height="12" Foreground="#38BDF8" IsVisible="{Binding IsAspect169}" />
                                </Grid>
                            </Button>
                            <Border Height="1" Background="#0EFFFFFF" Margin="8,0" />

                            <!-- 4:3 Standard -->
                            <Button Classes="iris-drawer-item" Command="{Binding SetAspectRatioCommand}" CommandParameter="4:3">
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Grid.Column="0" Text="4:3 Standard TV" FontSize="13" FontWeight="Medium" Foreground="#EEEEEE" VerticalAlignment="Center" />
                                    <PathIcon Grid.Column="1" Data="{StaticResource CheckIcon}" Width="12" Height="12" Foreground="#38BDF8" IsVisible="{Binding IsAspect43}" />
                                </Grid>
                            </Button>
                            <Border Height="1" Background="#0EFFFFFF" Margin="8,0" />

                            <!-- 2.35:1 Cinematic -->
                            <Button Classes="iris-drawer-item" Command="{Binding SetAspectRatioCommand}" CommandParameter="2.35:1">
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Grid.Column="0" Text="2.35:1 Anamorphic Cinematic" FontSize="13" FontWeight="Medium" Foreground="#EEEEEE" VerticalAlignment="Center" />
                                    <PathIcon Grid.Column="1" Data="{StaticResource CheckIcon}" Width="12" Height="12" Foreground="#38BDF8" IsVisible="{Binding IsAspect235}" />
                                </Grid>
                            </Button>
                            <Border Height="1" Background="#0EFFFFFF" Margin="8,0" />

                            <!-- 21:9 Ultra-Wide -->
                            <Button Classes="iris-drawer-item" Command="{Binding SetAspectRatioCommand}" CommandParameter="21:9">
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Grid.Column="0" Text="21:9 Ultra-Wide" FontSize="13" FontWeight="Medium" Foreground="#EEEEEE" VerticalAlignment="Center" />
                                    <PathIcon Grid.Column="1" Data="{StaticResource CheckIcon}" Width="12" Height="12" Foreground="#38BDF8" IsVisible="{Binding IsAspect219}" />
                                </Grid>
                            </Button>
                        </StackPanel>

                        <!-- ================= PAGE 3: PLAYBACK SPEED SUB-PAGE ================= -->
                        <StackPanel IsVisible="{Binding IsSpeedSubPage}" Spacing="2">
                            <!-- 0.5x -->
                            <Button Classes="iris-drawer-item" Command="{Binding SetSpeedCommand}" CommandParameter="0.5">
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Grid.Column="0" Text="0.5x (Slow Motion)" FontSize="13" FontWeight="Medium" Foreground="#EEEEEE" VerticalAlignment="Center" />
                                    <PathIcon Grid.Column="1" Data="{StaticResource CheckIcon}" Width="12" Height="12" Foreground="#38BDF8" IsVisible="{Binding IsSpeed05}" />
                                </Grid>
                            </Button>
                            <Border Height="1" Background="#0EFFFFFF" Margin="8,0" />

                            <!-- 0.75x -->
                            <Button Classes="iris-drawer-item" Command="{Binding SetSpeedCommand}" CommandParameter="0.75">
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Grid.Column="0" Text="0.75x" FontSize="13" FontWeight="Medium" Foreground="#EEEEEE" VerticalAlignment="Center" />
                                    <PathIcon Grid.Column="1" Data="{StaticResource CheckIcon}" Width="12" Height="12" Foreground="#38BDF8" IsVisible="{Binding IsSpeed075}" />
                                </Grid>
                            </Button>
                            <Border Height="1" Background="#0EFFFFFF" Margin="8,0" />

                            <!-- 1.0x (Normal) -->
                            <Button Classes="iris-drawer-item" Command="{Binding SetSpeedCommand}" CommandParameter="1.0">
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Grid.Column="0" Text="1.0x (Normal Speed)" FontSize="13" FontWeight="Medium" Foreground="#EEEEEE" VerticalAlignment="Center" />
                                    <PathIcon Grid.Column="1" Data="{StaticResource CheckIcon}" Width="12" Height="12" Foreground="#38BDF8" IsVisible="{Binding IsSpeed10}" />
                                </Grid>
                            </Button>
                            <Border Height="1" Background="#0EFFFFFF" Margin="8,0" />

                            <!-- 1.25x -->
                            <Button Classes="iris-drawer-item" Command="{Binding SetSpeedCommand}" CommandParameter="1.25">
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Grid.Column="0" Text="1.25x" FontSize="13" FontWeight="Medium" Foreground="#EEEEEE" VerticalAlignment="Center" />
                                    <PathIcon Grid.Column="1" Data="{StaticResource CheckIcon}" Width="12" Height="12" Foreground="#38BDF8" IsVisible="{Binding IsSpeed125}" />
                                </Grid>
                            </Button>
                            <Border Height="1" Background="#0EFFFFFF" Margin="8,0" />

                            <!-- 1.5x -->
                            <Button Classes="iris-drawer-item" Command="{Binding SetSpeedCommand}" CommandParameter="1.5">
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Grid.Column="0" Text="1.5x" FontSize="13" FontWeight="Medium" Foreground="#EEEEEE" VerticalAlignment="Center" />
                                    <PathIcon Grid.Column="1" Data="{StaticResource CheckIcon}" Width="12" Height="12" Foreground="#38BDF8" IsVisible="{Binding IsSpeed15}" />
                                </Grid>
                            </Button>
                            <Border Height="1" Background="#0EFFFFFF" Margin="8,0" />

                            <!-- 1.75x -->
                            <Button Classes="iris-drawer-item" Command="{Binding SetSpeedCommand}" CommandParameter="1.75">
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Grid.Column="0" Text="1.75x" FontSize="13" FontWeight="Medium" Foreground="#EEEEEE" VerticalAlignment="Center" />
                                    <PathIcon Grid.Column="1" Data="{StaticResource CheckIcon}" Width="12" Height="12" Foreground="#38BDF8" IsVisible="{Binding IsSpeed175}" />
                                </Grid>
                            </Button>
                            <Border Height="1" Background="#0EFFFFFF" Margin="8,0" />

                            <!-- 2.0x -->
                            <Button Classes="iris-drawer-item" Command="{Binding SetSpeedCommand}" CommandParameter="2.0">
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Grid.Column="0" Text="2.0x (Double Speed)" FontSize="13" FontWeight="Medium" Foreground="#EEEEEE" VerticalAlignment="Center" />
                                    <PathIcon Grid.Column="1" Data="{StaticResource CheckIcon}" Width="12" Height="12" Foreground="#38BDF8" IsVisible="{Binding IsSpeed20}" />
                                </Grid>
                            </Button>
                        </StackPanel>

                        <!-- ================= PAGE 4: SKIPPING & FRAME STEP INTERVAL SUB-PAGE ================= -->
                        <StackPanel IsVisible="{Binding IsSkippingSubPage}" Spacing="10">
                            <!-- Hero Indicator Card -->
                            <Border Background="#14FFFFFF" CornerRadius="10" Padding="14,12" BorderBrush="#2038BDF8" BorderThickness="1">
                                <StackPanel Spacing="4">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <TextBlock Text="CURRENT SKIP DURATION" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" LetterSpacing="1" />
                                        <Border CornerRadius="4" Padding="6,2" Background="#1838BDF8">
                                            <TextBlock Text="{Binding SeekStepPrecisionBadge}" FontSize="10" FontWeight="SemiBold" Foreground="#38BDF8" />
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{Binding SeekStepPrimaryDisplay}" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding SeekStepSecondaryDisplay}" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" />
                                    <TextBlock Text="Left / Right arrow keys skip by this exact interval." FontSize="11" Foreground="#64748B" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Dial & Stepper Controls -->
                            <Border Background="#0CFFFFFF" CornerRadius="10" Padding="12,10">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Dial &amp; Stepper" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1" />
                                    <Grid ColumnDefinitions="Auto, *, Auto" VerticalAlignment="Center">
                                        <!-- Decrement Button (-) -->
                                        <Button Grid.Column="0"
                                                Classes="iris-drawer-back-btn"
                                                Command="{Binding DecrementSeekStepCommand}"
                                                Width="42" Height="36"
                                                CornerRadius="8"
                                                Background="#18FFFFFF"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                ToolTip.Tip="Decrease skip duration (down to 1 frame / 10ms)">
                                            <PathIcon Data="{StaticResource MinusIcon}" Width="14" Height="14" Foreground="#CBD5E1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Button>

                                        <!-- Value Badge -->
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SeekStepDisplay}" FontSize="14" FontWeight="Bold" Foreground="#EEEEEE" HorizontalAlignment="Center" />
                                            <TextBlock Text="Min: 1 frame (10ms)" FontSize="10" Foreground="#64748B" HorizontalAlignment="Center" />
                                        </StackPanel>

                                        <!-- Increment Button (+) -->
                                        <Button Grid.Column="2"
                                                Classes="iris-drawer-back-btn"
                                                Command="{Binding IncrementSeekStepCommand}"
                                                Width="42" Height="36"
                                                CornerRadius="8"
                                                Background="#18FFFFFF"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                ToolTip.Tip="Increase skip duration">
                                            <PathIcon Data="{StaticResource PlusIcon}" Width="14" Height="14" Foreground="#CBD5E1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Button>
                                    </Grid>

                                    <!-- Slider Dial -->
                                    <Grid ColumnDefinitions="Auto, *, Auto" Margin="0,4,0,0" VerticalAlignment="Center">
                                        <TextBlock Grid.Column="0" Text="10ms" FontSize="10" Foreground="#64748B" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <Slider Grid.Column="1"
                                                Minimum="0.01"
                                                Maximum="30.0"
                                                Value="{Binding SeekStepSeconds, Mode=TwoWay}"
                                                Classes="iris-vol"
                                                VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="30s" FontSize="10" Foreground="#64748B" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Manual Number Entry -->
                            <Border Background="#0CFFFFFF" CornerRadius="10" Padding="12,10">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Manual Number Entry" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1" />
                                    <TextBlock Text="Enter duration in seconds (e.g. 0.033, 0.1, 0.5, 2.5) or milliseconds (e.g. 33ms, 50ms):" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" />
                                    <Grid ColumnDefinitions="*, Auto" Margin="0,4,0,0">
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding CustomSeekStepInput, Mode=TwoWay}"
                                                 Watermark="e.g. 0.033 or 50ms"
                                                 FontSize="12"
                                                 Padding="10,6"
                                                 Margin="0,0,8,0"
                                                 Background="#18191E"
                                                 Foreground="#FFFFFF"
                                                 BorderBrush="#334155"
                                                 CornerRadius="6"
                                                 KeyDown="OnCustomSeekStepKeyDown" />
                                        <Button Grid.Column="1"
                                                Command="{Binding ApplyCustomSeekStepCommand}"
                                                Classes="iris-drawer-back-btn"
                                                Background="#2038BDF8"
                                                Padding="14,6"
                                                CornerRadius="6"
                                                VerticalAlignment="Stretch">
                                            <TextBlock Text="Apply" FontSize="12" FontWeight="SemiBold" Foreground="#38BDF8" VerticalAlignment="Center" />
                                        </Button>
                                    </Grid>
                                    <TextBlock Text="Minimum limit: 1 frame (~0.033s / 10ms - NLE Standard)" FontSize="10" Foreground="#64748B" />
                                </StackPanel>
                            </Border>

                            <!-- Quick Presets -->
                            <Border Background="#0CFFFFFF" CornerRadius="10" Padding="12,10">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Quick Presets" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1" />
                                    <WrapPanel Orientation="Horizontal">
                                        <Button Classes="iris-preset-pill" Command="{Binding SetPresetSeekStepCommand}" CommandParameter="0.033" Margin="0,0,6,6">
                                            <TextBlock Text="1 Frame (33ms)" FontSize="11" />
                                        </Button>
                                        <Button Classes="iris-preset-pill" Command="{Binding SetPresetSeekStepCommand}" CommandParameter="0.01" Margin="0,0,6,6">
                                            <TextBlock Text="10 ms (Min)" FontSize="11" />
                                        </Button>
                                        <Button Classes="iris-preset-pill" Command="{Binding SetPresetSeekStepCommand}" CommandParameter="0.05" Margin="0,0,6,6">
                                            <TextBlock Text="50 ms" FontSize="11" />
                                        </Button>
                                        <Button Classes="iris-preset-pill" Command="{Binding SetPresetSeekStepCommand}" CommandParameter="0.1" Margin="0,0,6,6">
                                            <TextBlock Text="100 ms" FontSize="11" />
                                        </Button>
                                        <Button Classes="iris-preset-pill" Command="{Binding SetPresetSeekStepCommand}" CommandParameter="0.5" Margin="0,0,6,6">
                                            <TextBlock Text="500 ms" FontSize="11" />
                                        </Button>
                                        <Button Classes="iris-preset-pill" Command="{Binding SetPresetSeekStepCommand}" CommandParameter="1.0" Margin="0,0,6,6">
                                            <TextBlock Text="1.0 s" FontSize="11" />
                                        </Button>
                                        <Button Classes="iris-preset-pill" Command="{Binding SetPresetSeekStepCommand}" CommandParameter="2.0" Margin="0,0,6,6">
                                            <TextBlock Text="2.0 s" FontSize="11" />
                                        </Button>
                                        <Button Classes="iris-preset-pill" Command="{Binding SetPresetSeekStepCommand}" CommandParameter="5.0" Margin="0,0,6,6">
                                            <TextBlock Text="5.0 s (Default)" FontSize="11" />
                                        </Button>
                                        <Button Classes="iris-preset-pill" Command="{Binding SetPresetSeekStepCommand}" CommandParameter="10.0" Margin="0,0,6,6">
                                            <TextBlock Text="10.0 s" FontSize="11" />
                                        </Button>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- CCTV & Frame Inspection Guide Card -->
                            <Border Background="#1038BDF8" CornerRadius="8" Padding="12,10" BorderBrush="#2038BDF8" BorderThickness="1">
                                <StackPanel Spacing="4">
                                    <Grid ColumnDefinitions="Auto, *">
                                        <PathIcon Grid.Column="0" Data="{StaticResource CameraIcon}" Width="14" Height="14" Foreground="#38BDF8" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="CCTV &amp; Frame Inspection" FontSize="12" FontWeight="SemiBold" Foreground="#38BDF8" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Text="• Press '.' (Period) to step 1 frame forward." FontSize="11" Foreground="#CBD5E1" />
                                    <TextBlock Text="• Press ',' (Comma) to step 1 frame backward." FontSize="11" Foreground="#CBD5E1" />
                                    <TextBlock Text="• Press 'Ctrl+S' or 'S' to capture crystal-clear PNG snapshots to your configured folder." FontSize="11" Foreground="#CBD5E1" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Panel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ================= LAYER 5: PLAYLIST QUEUE DRAWER ================= -->
        <Border IsVisible="{Binding IsQueueOpen}"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Width="280"
                Background="#F0111114"
                BorderBrush="#222226"
                BorderThickness="1,0,0,0">
            <Grid RowDefinitions="Auto, *, Auto" Margin="12,36,12,12">
                <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,8">
                    <TextBlock Grid.Column="0" Text="Playlist Queue" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" />
                    <Button Grid.Column="1" Classes="iris-btn" Command="{Binding ToggleQueueCommand}" Padding="2" Height="20" Width="20">
                        <PathIcon Data="{StaticResource CloseIcon}" Width="10" Height="10" Foreground="#AAAAAA" />
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="1">
                    <ItemsControl ItemsSource="{Binding Playlist}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="models:MediaItem">
                                <Border CornerRadius="4"
                                        Background="#0CFFFFFF"
                                        Margin="0,0,0,4"
                                        Padding="8,6">
                                    <Grid ColumnDefinitions="Auto, *, Auto">
                                        <Button Grid.Column="0" Classes="iris-btn"
                                                Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).PlayMediaItemCommand}"
                                                CommandParameter="{Binding}"
                                                Padding="0" Height="16" Width="16" Margin="0,0,6,0">
                                            <PathIcon Data="{StaticResource PlayIcon}" Width="9" Height="9" Foreground="{StaticResource AccentLiquidBrush}" />
                                        </Button>
                                        <TextBlock Grid.Column="1" Text="{Binding FileName}" FontSize="11" Foreground="#EEEEEE" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <Button Grid.Column="2" Classes="iris-btn"
                                                Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).RemoveQueueItemCommand}"
                                                CommandParameter="{Binding}"
                                                Padding="2" Height="18" Width="18">
                                            <PathIcon Data="{StaticResource CloseIcon}" Width="8" Height="8" Foreground="#888888" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Spacing="4" Margin="0,8,0,0">
                    <Button Classes="iris-menu-item" Click="OnOpenFileClick" Background="#14FFFFFF">
                        <TextBlock Text="+ Add Media File" FontSize="11" HorizontalAlignment="Center" />
                    </Button>
                    <Button Classes="iris-menu-item" Command="{Binding ClearQueueCommand}">
                        <TextBlock Text="Clear Queue" FontSize="11" Foreground="#888888" HorizontalAlignment="Center" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= LAYER 6: SUBTITLES & AUDIO TRACKS CORNER POPOVER ================= -->
        <!-- Arises directly above the CC button in the bottom-right corner -->
        <Border IsVisible="{Binding IsTracksMenuOpen}"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,12,52"
                Width="260"
                Background="#F0141416"
                BorderBrush="#28282E"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10"
                BoxShadow="0 8 32 #80000000">
            <StackPanel Spacing="8">
                <!-- Segmented Tabs Header: [ Audio ] [ Subtitles ] and [X] -->
                <Grid ColumnDefinitions="*, Auto">
                    <Border Grid.Column="0" Background="#18FFFFFF" CornerRadius="6" Padding="2" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button Classes="iris-tab-btn"
                                    Classes.active="{Binding IsAudioTabSelected}"
                                    Command="{Binding SelectAudioTabCommand}"
                                    Content="Audio" />
                            <Button Classes="iris-tab-btn"
                                    Classes.active="{Binding IsSubtitlesTabSelected}"
                                    Command="{Binding SelectSubtitlesTabCommand}"
                                    Content="Subtitles" />
                        </StackPanel>
                    </Border>

                    <Button Grid.Column="1" Classes="iris-btn" Command="{Binding ToggleTracksMenuCommand}" Padding="2" Height="22" Width="22">
                        <PathIcon Data="{StaticResource CloseIcon}" Width="9" Height="9" Foreground="#AAAAAA" />
                    </Button>
                </Grid>

                <!-- 1. AUDIO TAB VIEW -->
                <StackPanel IsVisible="{Binding IsAudioTabSelected}" Spacing="4">
                    <TextBlock Text="Audio Streams" FontSize="10" FontWeight="SemiBold" Foreground="#888890" Margin="4,2,0,2" />
                    <TextBlock Text="No audio streams detected"
                               FontSize="11"
                               Foreground="#666670"
                               Margin="8,4,8,4"
                               IsVisible="{Binding !AudioTracks.Count}" />
                    <ScrollViewer MaxHeight="180">
                        <ItemsControl ItemsSource="{Binding AudioTracks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="models:TrackInfo">
                                    <Button Classes="iris-menu-item"
                                            Classes.active="{Binding IsSelected}"
                                            Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectTrackCommand}"
                                            CommandParameter="{Binding}"
                                            Margin="0,1,0,1">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding DisplayText}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <PathIcon Grid.Column="1" Data="{StaticResource CheckIcon}" Width="10" Height="10" Foreground="{StaticResource AccentLiquidBrush}" IsVisible="{Binding IsSelected}" VerticalAlignment="Center" Margin="6,0,2,0" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>

                <!-- 2. SUBTITLES TAB VIEW -->
                <StackPanel IsVisible="{Binding IsSubtitlesTabSelected}" Spacing="6">
                    <TextBlock Text="Subtitle Streams" FontSize="10" FontWeight="SemiBold" Foreground="#888890" Margin="4,2,0,2" />
                    <!-- Option to Turn Off Subtitles -->
                    <Button Classes="iris-menu-item" Command="{Binding DisableSubtitlesCommand}" Margin="0,1,0,1">
                        <TextBlock Text="None (Subtitles Off)" FontSize="11" Foreground="#AAAAAA" />
                    </Button>
                    <TextBlock Text="No embedded subtitles detected"
                               FontSize="11"
                               Foreground="#666670"
                               Margin="8,2,8,2"
                               IsVisible="{Binding !SubtitleTracks.Count}" />
                    <ScrollViewer MaxHeight="140">
                        <ItemsControl ItemsSource="{Binding SubtitleTracks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="models:TrackInfo">
                                    <Button Classes="iris-menu-item"
                                            Classes.active="{Binding IsSelected}"
                                            Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectTrackCommand}"
                                            CommandParameter="{Binding}"
                                            Margin="0,1,0,1">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding DisplayText}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <PathIcon Grid.Column="1" Data="{StaticResource CheckIcon}" Width="10" Height="10" Foreground="{StaticResource AccentLiquidBrush}" IsVisible="{Binding IsSelected}" VerticalAlignment="Center" Margin="6,0,2,0" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Load External Subtitle File Button -->
                    <Button Classes="iris-menu-item" Click="OnAddExternalSubtitleClick" Background="#18FFFFFF">
                        <TextBlock Text="+ Load Subtitle File..." FontSize="11" HorizontalAlignment="Center" Foreground="{StaticResource AccentLiquidBrush}" FontWeight="SemiBold" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ================= LAYER 7: TECHNICAL INFO OVERLAY MODAL ================= -->
        <Border IsVisible="{Binding IsInfoModalOpen}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="420"
                Background="#F2121215"
                BorderBrush="#282830"
                BorderThickness="1"
                CornerRadius="12"
                Padding="20"
                BoxShadow="0 12 40 #A0000000">
            <StackPanel Spacing="14">
                <!-- Modal Header -->
                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                        <Border Background="#1A388BFD" CornerRadius="6" Padding="6,3">
                            <TextBlock Text="CORE ENGINE" FontSize="10" FontWeight="Bold" Foreground="#388BFD" />
                        </Border>
                        <TextBlock Text="Technical Diagnostics" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="iris-btn" Command="{Binding ToggleInfoModalCommand}" Padding="2" Height="22" Width="22">
                        <PathIcon Data="{StaticResource CloseIcon}" Width="10" Height="10" Foreground="#AAAAAA" />
                    </Button>
                </Grid>

                <Border BorderBrush="#14FFFFFF" BorderThickness="0,1,0,0" />

                <!-- Telemetry Stack -->
                <StackPanel Spacing="8">
                    <!-- Resolution & Aspect Ratio -->
                    <Grid ColumnDefinitions="140,*">
                        <TextBlock Grid.Column="0" Text="Resolution:" FontSize="11" Foreground="#888890" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding CurrentStats.FormattedResolution, FallbackValue='N/A'}" FontSize="11" FontWeight="Medium" Foreground="#FFFFFF" />
                    </Grid>

                    <!-- Hardware Acceleration -->
                    <Grid ColumnDefinitions="140,*">
                        <TextBlock Grid.Column="0" Text="Hardware Decoder:" FontSize="11" Foreground="#888890" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding CurrentStats.HardwareDecoder, FallbackValue='Auto (Safe)'}" FontSize="11" FontWeight="Medium" Foreground="#4EC9B0" />
                            <Border Background="#204EC9B0" CornerRadius="4" Padding="4,1" IsVisible="{Binding CurrentStats.IsHardwareAccelerated, FallbackValue=false}">
                                <TextBlock Text="Active" FontSize="9" FontWeight="Bold" Foreground="#4EC9B0" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Codecs -->
                    <Grid ColumnDefinitions="140,*">
                        <TextBlock Grid.Column="0" Text="Video Codec:" FontSize="11" Foreground="#888890" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding VideoCodec, FallbackValue='Unknown'}" FontSize="11" Foreground="#CCCCCC" />
                    </Grid>

                    <Grid ColumnDefinitions="140,*">
                        <TextBlock Grid.Column="0" Text="Audio Codec:" FontSize="11" Foreground="#888890" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding AudioCodec, FallbackValue='Unknown'}" FontSize="11" Foreground="#CCCCCC" />
                    </Grid>

                    <!-- FPS & Frame Drop -->
                    <Grid ColumnDefinitions="140,*">
                        <TextBlock Grid.Column="0" Text="Framerate:" FontSize="11" Foreground="#888890" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding CurrentStats.FormattedFps, FallbackValue='0 fps'}" FontSize="11" Foreground="#FFFFFF" />
                    </Grid>

                    <!-- Bitrate -->
                    <Grid ColumnDefinitions="140,*">
                        <TextBlock Grid.Column="0" Text="Video Bitrate:" FontSize="11" Foreground="#888890" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding CurrentStats.FormattedVideoBitrate, FallbackValue='N/A'}" FontSize="11" Foreground="#CCCCCC" />
                    </Grid>

                    <!-- Cache Buffer -->
                    <Grid ColumnDefinitions="140,*">
                        <TextBlock Grid.Column="0" Text="Demuxer Cache:" FontSize="11" Foreground="#888890" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding CurrentStats.FormattedCache, FallbackValue='100%'}" FontSize="11" Foreground="#CCCCCC" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>

    </Grid>
</Window>
